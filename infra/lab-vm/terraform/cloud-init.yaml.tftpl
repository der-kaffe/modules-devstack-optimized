#cloud-config
hostname: tt-openstack-lab
manage_etc_hosts: true
ssh_pwauth: false
disable_root: true
swap:
  filename: /swapfile
  size: 7516192768
  maxsize: 7516192768
packages:
  - qemu-guest-agent
runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
users:
  - name: stack
    gecos: DevStack laboratory
    groups: sudo
    shell: /bin/bash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}
