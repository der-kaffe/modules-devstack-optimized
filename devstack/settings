# DevStack plugin settings: Glance in Go (devstack@g-go).
#
#   [[local|localrc]]
#   enable_plugin glance-go https://github.com/PaoloCastanon/modules-devstack-optimized main
#
# By default no Python Glance is installed: lib/glance-go-only replaces
# DevStack's lib/glance functions (install, configure, accounts, init, start)
# with Glance Go and its glance-manage, cache tools and scrubber. The image
# endpoint, glance-api.conf and database are the ones DevStack would create.
#
# GLANCE_GO_INSTALL_ORIGINAL=True also installs the original Glance (g-api),
# stopped, for comparisons: DevStack configures and migrates it, uploads
# CirrOS through it, then the plugin starts g-go in its place.

enable_service g-go
GLANCE_GO_INSTALL_ORIGINAL=$(trueorfalse False GLANCE_GO_INSTALL_ORIGINAL)

# Where enable_plugin cloned this repository.
GLANCE_GO_DIR=${GLANCE_GO_DIR:-$DEST/glance-go}
GLANCE_GO_BIN=${GLANCE_GO_BIN:-$GLANCE_GO_DIR/bin/glance}
# Private root for the store lock and scope marker (image files go to the
# original's filesystem_store_datadir).
GLANCE_GO_STORE_ROOT=${GLANCE_GO_STORE_ROOT:-$DATA_DIR/g-go/store-root}
GLANCE_GO_LISTEN=${GLANCE_GO_LISTEN:-127.0.0.1:19292}
# Extra GLANCE_GO_* settings for the unit, space separated (see
# configs/glance.env.example), e.g. "GLANCE_GO_MAX_CONCURRENT_TRANSFERS=16".
GLANCE_GO_EXTRA_ENV=${GLANCE_GO_EXTRA_ENV:-}

# Go toolchain used to build Glance Go, downloaded once from go.dev and checked
# against its published SHA-256 (linux-amd64). Set GLANCE_GO_TOOLCHAIN_SHA256 for
# another version or architecture.
GLANCE_GO_TOOLCHAIN_VERSION=${GLANCE_GO_TOOLCHAIN_VERSION:-1.27.4}
GLANCE_GO_TOOLCHAIN_SHA256=${GLANCE_GO_TOOLCHAIN_SHA256:-7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840}
GLANCE_GO_TOOLCHAIN_DIR=${GLANCE_GO_TOOLCHAIN_DIR:-$DEST/go-$GLANCE_GO_TOOLCHAIN_VERSION}

source $GLANCE_GO_DIR/devstack/lib/glance-go
if [[ "$GLANCE_GO_INSTALL_ORIGINAL" != "True" ]]; then
    disable_service g-api
    source $GLANCE_GO_DIR/devstack/lib/glance-go-only
fi
